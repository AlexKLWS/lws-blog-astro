# Copy this file to `.env` for local development:  cp .env.example .env
#
# `.env` is gitignored — never commit it. For the deployed site, set these same
# two variables in the Cloudflare Pages dashboard instead (see below).
#
# Both values here are PUBLIC by design. Astro inlines any PUBLIC_-prefixed
# variable into the built HTML/JS at build time, so they are visible to anyone
# viewing source. That is fine for these two — but it is exactly why the Resend
# API key and the Turnstile SECRET key must never appear in this file or in this
# repo at all. Those live in GCP Secret Manager; see playtest-service/README.md.

# Where the playtest form submits. Locally this is the functions-framework dev
# server (`npm run dev` inside playtest-service/). In production it is the
# Cloud Run service URL.
PUBLIC_PLAYTEST_ENDPOINT=http://localhost:8080

# Cloudflare Turnstile SITE key (the public half of the pair).
# The value below is Cloudflare's official "always passes" test key, so the
# widget works locally without contacting your real Turnstile config.
# Replace it with your real site key in the Cloudflare Pages environment.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
