# Copy to .env for local development. Cloud Run gets these via --set-env-vars
# and --set-secrets instead; never commit real values.

# --- secrets (Secret Manager in production) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxx

# --- plain config ---
GOOGLE_CLOUD_PROJECT=player-signup-automation
ALLOWED_ORIGINS=https://blog.longwintershadows.com,http://localhost:4321

# Fallbacks used only when a campaign document does not set its own. Per-game
# values belong on the campaign document, not here.
FROM_EMAIL=Long Winter Shadows <playtest@longwintershadows.com>
REPLY_TO_EMAIL=alexkorzh7@gmail.com
DEFAULT_DEVELOPER=Long Winter Shadows
DEFAULT_SIGN_OFF=Alex
SITE_NAME=longwintershadows.com

# Per-IP backstop behind Turnstile, counted across all campaigns.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=86400000

# Local development only: skip Turnstile verification. Never set in production.
# SKIP_TURNSTILE=1
